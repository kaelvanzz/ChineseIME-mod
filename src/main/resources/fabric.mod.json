{
  "schemaVersion": 1,
  "id": "chineseime",
  "version": "${version}",
  "name": "中文输入法 + 词语联想",
  "description": "在全屏模式下使用系统中文输入法，并在屏幕上实时显示词语联想。支持拼音、五笔、仓颉、注音、粤语等多种输入方案。",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.chineseime.ChineseIMEInitializer"
    ],
    "modmenu": [
      "com.example.chineseime.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "chineseime.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "fabric-api": ">=0.141.6+1.21.11",
    "modmenu": ">=17.0.0"
  }
}
